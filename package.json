{
  "name": "dsh-minimal-transcript",
  "version": "0.1.0",
  "description": "Hide DSH 0.1.1-rc.2 thinking and tool-process rows in the Web UI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": {"dsh": ">=0.1.1-rc.2 <0.1.2"},
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "plugin", "web-ui", "transcript", "minimal"],
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  }
}
